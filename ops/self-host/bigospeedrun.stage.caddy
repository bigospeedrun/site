# /etc/wg-caddy/bigospeedrun.caddy (staging; phase D replaces it with the real names)
stage.bigospeedrun.com {
	tls internal
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow, noarchive"
	request_body {
		max_size 1MiB
	}
	log {
		output file /var/log/wg-caddy/bigospeedrun-access.json {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request delete
			}
		}
	}
	reverse_proxy unix//run/bigospeedrun/site.sock {
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto https
		flush_interval -1
		lb_try_duration 15s
		lb_try_interval 250ms
		transport http {
			dial_timeout 5s
			response_header_timeout 70s
		}
	}
}
