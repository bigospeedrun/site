# /etc/bigospeedrun/auto-deploy.env (0600, root; the directory is 0700). Plain KEY=value
# lines, read by auto-deploy.sh and never run as shell. No secrets here: the site's API keys
# go in /etc/bigospeedrun/site.env (compose.yaml).
BOS_IMAGE=ghcr.io/bigospeedrun/site
BOS_GITHUB_REPO=bigospeedrun/site
BOS_IMAGE_WORKFLOW=site-image.yml
