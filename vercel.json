{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/chat.ts": {
      "maxDuration": 60,
      "includeFiles": "dist/chat-knowledge.json"
    },
    "api/markdown.ts": {
      "includeFiles": "dist/agent-pages.json"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "/((?!api/|_astro/)(?:[^.]*|.*\\.html))",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/api/markdown?agentPath=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/api/markdown?agentPath=$1"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
