---
import '../styles/site.css';
import ProblemsMenu from '../components/ProblemsMenu.astro';
import Chatbot from '../components/Chatbot.astro';
import {dataUpdatedAt} from '../lib/data';
import 'katex/dist/katex.min.css';
import {pageSeo, shareImage, siteOrigin} from '../lib/seo';
interface Props { title: string; home?: boolean; dataUpdated?: string; }
const { title, home = false, dataUpdated = dataUpdatedAt } = Astro.props;
const pageTitle=home?'Big O Speedrun':title+' · Big O Speedrun';
const {canonical,description,noindex}=pageSeo(Astro.url.pathname);
const fallbackDate = new Intl.DateTimeFormat('en-US', {timeZone:'America/Los_Angeles', month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}).format(new Date(dataUpdated));
---
<!doctype html><html lang="en"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{pageTitle}</title><meta name="description" content={description}/>
{noindex&&<meta name="robots" content="noindex"/>}
<link rel="canonical" href={canonical}/>
<link rel="help" type="text/plain" href="/llms.txt" title="Agent guide"/>
<link rel="alternate" type="application/json" href="/chat-knowledge.json" title="Current records and evidence"/>
{home && <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebSite',name:'Big O Speedrun',url:siteOrigin,description,sameAs:'https://github.com/bigospeedrun'}).replace(/</g,'\\u003c')}/>}

<link rel="icon" href="/favicon.ico" sizes="any"/>
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32"/>
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192"/>
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180"/>
<link rel="manifest" href="/site.webmanifest"/>
<meta property="og:type" content="website"/>
<meta property="og:url" content={canonical}/>
<meta property="og:title" content={pageTitle}/>
<meta property="og:description" content={description}/>
<meta property="og:image" content={shareImage}/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta property="og:image:alt" content="Big O Speedrun logo and site name"/>
<meta property="og:site_name" content="Big O Speedrun"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:url" content={canonical}/>
<meta name="twitter:title" content={pageTitle}/>
<meta name="twitter:description" content={description}/>
<meta name="twitter:image" content={shareImage}/>
<meta name="twitter:image:alt" content="Big O Speedrun logo and site name"/>
<meta name="theme-color" content="#f5f7fb" media="(prefers-color-scheme: light)"/>
<meta name="theme-color" content="#111925" media="(prefers-color-scheme: dark)"/>
<script is:inline defer src="/analytics.js"></script>
<script is:inline>try{const t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch{}</script>
</head><body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header"><a class="brand" href="/"><img src="/icon-192.png" width="44" height="44" alt=""/><span>Big O <strong>Speedrun</strong></span></a><div class="header-actions"><ProblemsMenu /><a href="/about" aria-current={Astro.url.pathname.replace(/\/$/,'')==='/about'?'page':undefined}>About</a><button id="theme" aria-label="Switch color theme" title="Switch color theme"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g class="theme-sun"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></g><path class="theme-moon" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg></button></div></header>
<main id="main" class:list={{home}}><slot/></main>
<footer class="site-footer">
  <p class="footer-links"><a href="https://github.com/bigospeedrun" target="_blank" rel="noopener">GitHub</a> · <a href="/about">About</a> · <a href="/privacy">Privacy</a> · <span>Created by <a href="https://nilmamano.com">Nil Mamano</a></span> · <span class="data-updated">Data updated <time datetime={dataUpdated} data-local-datetime>{fallbackDate} PT</time></span></p>
</footer>
<script>
  const themeButton=document.getElementById('theme')!;
  const systemTheme=matchMedia('(prefers-color-scheme: dark)');
  const isDark=()=>document.documentElement.dataset.theme?document.documentElement.dataset.theme==='dark':systemTheme.matches;
  const updateThemeButton=()=>{const label=isDark()?'Switch to light mode':'Switch to dark mode';themeButton.setAttribute('aria-label',label);themeButton.title=label;};
  themeButton.addEventListener('click',()=>{const root=document.documentElement;root.dataset.theme=isDark()?'light':'dark';try{localStorage.setItem('theme',root.dataset.theme)}catch{}updateThemeButton();});
  systemTheme.addEventListener('change',updateThemeButton);
  updateThemeButton();
  for (const element of document.querySelectorAll<HTMLTimeElement>('time[data-local-datetime]')) {
    const date = new Date(element.dateTime);
    if (Number.isFinite(date.getTime())) element.textContent = new Intl.DateTimeFormat(undefined, {month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}).format(date);
  }
</script>
<Chatbot />
</body></html>
