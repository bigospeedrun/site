---
import type {RecordEntry} from '../lib/types';
import {math} from '../lib/math';
import {evidenceName,breakthroughLabel} from '../lib/evidence';
import RecordDate from './RecordDate.astro';
import InfoTooltip from './InfoTooltip.astro';
interface Props {rows:{record:RecordEntry;rank:number;tie:boolean}[];label:string;}
const {rows,label}=Astro.props;
const github=(url?:string)=>url?.startsWith('https://github.com/');
// This dependency is the shared CrocSwap reduction, not an extra condition on one row.
const extraDependencies=(r:RecordEntry)=>r.dependencies.filter(d=>!(r.repo==='CrocSwap/integer-mult-bounds'&&d.id==='openai-109-transfer'));
const assumptions=(r:RecordEntry)=>extraDependencies(r).map(d=>{
 const text=d.statement;
 if(text.startsWith('Conditional on'))return 'This bound assumes the stated analytic estimates, recursion for all input sizes and transfer to a fixed-tape machine.';
 if(text.startsWith('Retained OpenAI'))return 'The README lists proof steps that have not been independently checked, including storage reuse and the step that mixes paired values (round eleven, Proof interfaces). Its finite tests do not establish the full multiplication bound.';
 if(text.startsWith('The OpenAI #109 fixed-tape'))return 'This bound assumes the OpenAI fixed-tape reduction and the source’s compiler, routing, precision, resampling and exact-recovery claims for all input sizes.';
 if(text.startsWith('The OpenAI #109 multiplication'))return 'This bound assumes the OpenAI multiplication framework and the source’s analytic estimates and fixed-tape transfer.';
 if(text.startsWith('The inherited OpenAI'))return 'This bound assumes the OpenAI fixed-tape reduction and the source’s transfer for all input sizes. It also assumes that stage two is the complement time-reversal of stage one.';
 if(text.startsWith('Correctness of the community'))return 'This bound assumes the community paired-cube complex network is correct, together with the stated batched recursion and Fourier transfer.';
 if(text.startsWith('Correctness of the pinned'))return 'This bound assumes the pinned Swapnil-jain round-six complex network is correct, together with the stated transfer to OpenAI’s Fourier algorithm.';
 return text;
}).join(' ');
---
<div class="results-scroll" role="region" aria-label={label}><table><thead><tr><th scope="col">Rank</th><th scope="col">Bound</th><th scope="col"><span class="desktop-label">Evidence level</span><span class="phone-label">Level</span></th><th class="supplemental" scope="col">Player</th><th class="supplemental" scope="col">Date</th><th class="supplemental" scope="col">Link</th></tr></thead><tbody>
{rows.map(({record:r,rank,tie},i)=><tr data-level={r.evidenceLevel} data-breakthrough={r.isBreakthrough?'true':undefined} hidden={i>=10}>
<td class="rank">{tie?'=':''}{rank}</td><td class="bound"><span title={'Exact score: '+r.score+(r.scoreRelation==='strict-upper-bound'?'; strict endpoint: the bound holds for every fixed positive epsilon, not at the endpoint.':'')} set:html={math(r.bound)}/>{extraDependencies(r).length>0&&<span class="assumptions"><InfoTooltip label="Assumptions for this bound">{assumptions(r)} {r.id==='swapnil-snapshot-ea9e8685d1621a98'&&<>{' '}<a href={r.dependencies[0].source_url+'#L73-L89'} target="_blank" rel="noopener">README, proof interfaces</a></>}</InfoTooltip></span>}</td><td class="level-cell">{r.isBreakthrough?<span class="level breakthrough" tabindex="0" title={r.evidenceLevel==='lean-verified'?'This is the first result that improves the classic bound; we rebuilt its Lean proof and checked with the Lean kernel that it proves our exact problem statement.':'This is the first result that improves the classic bound from its source paper; we have not checked a full Lean proof of this bound.'}>{breakthroughLabel}{r.evidenceLevel==='lean-verified'&&<span class="level" data-evidence="lean-verified"> · Lean Verified</span>}</span>:<span class="level" data-evidence={r.evidenceLevel}>{evidenceName(r.evidenceLevel)}</span>}</td>
<td class="authors supplemental">{r.authors.map(a=><a href={a.url} target={github(a.url)?'_blank':undefined} rel={github(a.url)?'noopener':undefined}>{a.name}</a>)}</td><td class="supplemental"><RecordDate record={r}/></td><td class="supplemental"><a href={r.evidence[0]?.url} target={github(r.evidence[0]?.url)?'_blank':undefined} rel={github(r.evidence[0]?.url)?'noopener':undefined}>Source</a></td>
<td class="mobile-meta">{r.authors.map((a,i)=><>{i?', ':''}<a href={r.evidence[0]?.url} target={github(r.evidence[0]?.url)?'_blank':undefined} rel={github(r.evidence[0]?.url)?'noopener':undefined}>{a.name}</a></>)} <span aria-hidden="true">·</span> <RecordDate record={r}/></td></tr>)}
</tbody></table></div>
<style>
.results-scroll{border:1px solid var(--line);border-radius:.5rem}table{border-collapse:collapse;width:100%;font-size:1rem}th,td{padding:.85rem .75rem;text-align:left;border-bottom:1px solid var(--line);vertical-align:top}th{font-size:1rem;font-weight:600;color:var(--fg);background:var(--surface);letter-spacing:normal}tr:last-child td{border-bottom:0}tr[hidden]{display:none}td.bound{position:relative}.bound>span{white-space:nowrap}.bound :global(.katex){font-size:22px}.authors a{display:block}.level{font-size:.95rem}.level[data-evidence="claimed"]{color:var(--claimed)}.level[data-evidence="human-verified"]{color:var(--human-verified)}.level[data-evidence="lean-verified"]{color:var(--lean-verified)}summary{cursor:pointer;white-space:nowrap}.mobile-meta{display:none}.mobile-meta p{margin:.6rem 0}td :global(time){white-space:nowrap}
.breakthrough{color:var(--accent);font-weight:600}.phone-label{display:none}.assumptions{display:inline-block;margin-left:.4rem}
@media(max-width:900px){
 tr[data-breakthrough="true"]{grid-template-columns:2.5rem minmax(0,1fr) 7.1rem} .breakthrough{overflow-wrap:normal;font-weight:500}
 table,thead,tbody{display:block}tr{display:grid;grid-template-columns:3rem minmax(0,1fr) 5.5rem;border-bottom:1px solid var(--line)}tr:last-child{border-bottom:0}
 th,td{padding:.7rem .35rem;border:0;min-width:0}th{font-size:.9375rem}th:first-child,td.rank{padding-left:.5rem}.supplemental{display:none}.level{white-space:normal;font-size:.9375rem;line-height:1.35;display:inline-block}.bound :global(.katex){font-size:22px}
 .mobile-meta{display:block;grid-column:1/-1;padding:.1rem .7rem .6rem}.mobile-meta{font-size:.9375rem;line-height:1.5;overflow-wrap:anywhere}.mobile-meta a{overflow-wrap:anywhere}.desktop-label{display:none}.phone-label{display:inline}.results-scroll{overflow:visible}.bound{display:flex;flex-wrap:wrap;align-content:start;gap:.3rem}.assumptions{margin:0}
}
</style>
