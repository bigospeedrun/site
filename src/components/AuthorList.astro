---
import type {Author} from '../lib/types';
import PlayerAvatar from './PlayerAvatar.astro';
interface Props {authors: Author[]}
const {authors}=Astro.props;
// Grouped source credits stay intact; the disclosure separates them from other entries.
const useList=authors.length>2||authors.some(author=>/\s(?:and|&)\s|,\s/.test(author.name));
---
<span class="author-list">
{!useList ? authors.map((author,index)=><>{index>0&&' and '}<span class:list={["author",{"with-handle":Boolean(author.twitterUsername)}]}><PlayerAvatar author={author}/><a href={author.url} target="_blank" rel="noopener">{author.name}</a>{author.twitterUsername&&<> <a class="x-handle" href={`https://x.com/${author.twitterUsername}`} target="_blank" rel="noopener" aria-label={`${author.name} on X`}>@{author.twitterUsername}</a></>}</span></>) : <details><summary><span class="avatar-stack">{authors.slice(0,3).map(author=><PlayerAvatar author={author}/>)}</span>Show authors</summary><ul>{authors.map(author=><li><span class:list={["author",{"with-handle":Boolean(author.twitterUsername)}]}><PlayerAvatar author={author}/><a href={author.url} target="_blank" rel="noopener">{author.name}</a>{author.twitterUsername&&<> <a class="x-handle" href={`https://x.com/${author.twitterUsername}`} target="_blank" rel="noopener" aria-label={`${author.name} on X`}>@{author.twitterUsername}</a></>}</span></li>)}</ul></details>}
</span>
<style>
.author-list{overflow-wrap:anywhere;line-height:1.6}.author{display:inline-block;max-width:100%;vertical-align:middle}.with-handle{white-space:nowrap;overflow-wrap:normal}.author a,li a{text-decoration:underline;text-underline-offset:.18em;display:inline-block;min-height:44px;align-content:center}.x-handle{font-size:.9em}details{display:inline-block;vertical-align:top;max-width:100%}summary{cursor:pointer;min-height:44px;align-content:center;color:var(--link, var(--accent));text-decoration:underline;text-underline-offset:.18em}ul{margin:.2rem 0;padding-left:1.2rem}.avatar-stack{display:inline-flex;vertical-align:middle;margin-right:.45rem}.avatar-stack :global(.player-avatar){margin-right:-8px;box-shadow:0 0 0 2px var(--surface)}.avatar-stack :global(.player-avatar:last-child){margin-right:0}a:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
</style>
