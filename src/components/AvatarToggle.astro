<avatar-toggle><label><input type="checkbox" checked/> Show avatars</label></avatar-toggle>
<script>
import {getShowAvatars,setShowAvatars,subscribeShowAvatars} from '../lib/avatars';
class AvatarToggle extends HTMLElement{
 private unsubscribe?:()=>void;
 connectedCallback(){
  const input=this.querySelector<HTMLInputElement>('input')!;
  const render=()=>{input.checked=getShowAvatars()};
  input.addEventListener('change',()=>setShowAvatars(input.checked));
  this.unsubscribe=subscribeShowAvatars(render);render();
  // History navigation can restore the checkbox after this element initializes.
  window.addEventListener('pageshow',()=>requestAnimationFrame(render));
 }
 disconnectedCallback(){this.unsubscribe?.()}
}
customElements.define('avatar-toggle',AvatarToggle);
</script>
<style>
avatar-toggle{display:block;margin:0 0 1rem}label{display:flex;gap:.4rem;align-items:center;cursor:pointer}input{width:1rem;height:1rem;accent-color:var(--accent)}
@media(max-width:600px){avatar-toggle{margin-bottom:.6rem}label{min-height:36px}}
</style>
