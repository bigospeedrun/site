---
import type {Author} from '../lib/types';
import {initials} from '../lib/avatars';
interface Props {author:Author}
const {author}=Astro.props;
// Decorative: the player name sits next to it.
---
<span class:list={["player-avatar",{initials:!author.avatar}]} aria-hidden="true">{author.avatar?<img src={author.avatar} width="24" height="24" alt="" loading="lazy" decoding="async"/>:initials(author.name)}</span>
<style>
.player-avatar{display:inline-flex;align-items:center;justify-content:center;flex:none;width:24px;height:24px;border-radius:50%;overflow:hidden;vertical-align:middle;margin-right:.45rem;box-shadow:0 0 0 1px var(--line);background:var(--subtle);color:var(--fg);font-size:10px;font-weight:600;line-height:1;letter-spacing:normal;user-select:none}
.player-avatar img{display:block;width:100%;height:100%;object-fit:cover}
</style>
