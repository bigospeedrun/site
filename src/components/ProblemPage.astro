---
import Layout from '../layouts/Layout.astro';
import {problemDisplayName} from '../lib/navigation';
import {boardRecords} from '../lib/data';
import ProgressChart from './ProgressChart.astro';
import Leaderboard from './Leaderboard.astro';
import InfoTooltip from './InfoTooltip.astro';
import {repoSelectionText} from '../lib/site';
import {math} from '../lib/math';
import {localTimeFallback} from '../lib/freshness';
import {boardUrl} from '../lib/board';
import {prove2meCampaign} from '../lib/submission';
interface Props {p:import('../lib/types').Problem;}
const {p}=Astro.props;
const displayName=problemDisplayName(p.slug,p.title);
const records=boardRecords(p);
const board=boardUrl(p.slug);
const campaign=prove2meCampaign(p);
// Rows imported from prove2.me (data/prove2me_import.py) are Lean Verified while LEAN_VERIFIED is True; the Lean rule names them then.
const prove2meLean=records.some(r=>r.prove2me&&r.evidenceLevel==='lean-verified');
const classic=p.records.find(r=>r.id==='classical-baseline');
const classicCitations:Record<string,{name:string;url:string}[]>={
 'matrix-multiplication':[{name:'Dupont et al., preprint published August 17, 2026',url:'https://arxiv.org/abs/2608.16884'}],
 '3sum':[{name:'Gajentaan and Overmars 1995, account of the folklore algorithm',url:'https://people.csail.mit.edu/virgi/6.s078/papers/gajovermars.pdf'}],
 'apsp':[{name:'Floyd 1962',url:'https://doi.org/10.1145/367766.368168'}],
 'subset-sum':[{name:'Horowitz and Sahni 1974',url:'https://doi.org/10.1145/321812.321823'}],
 'integer-multiplication':[{name:'Harvey and van der Hoeven 2021',url:'https://annals.math.princeton.edu/2021/193-2/p04'}],
 'exact-dft':[{name:'Cooley and Tukey 1965',url:'https://doi.org/10.1090/S0025-5718-1965-0178586-1'},{name:'Bluestein 1970',url:'https://doi.org/10.1109/TAU.1970.1162132'}],
 'directed-sssp':[{name:'Fredman and Tarjan 1987',url:'https://doi.org/10.1145/28869.28874'}],
 '3sat':[{name:'Jiang and Cai 2026, preprint',url:'https://arxiv.org/abs/2607.10697'}],
 'integer-factoring':[{name:'Harvey and Hittmeir 2022',url:'https://doi.org/10.1090/mcom/3708'}],
};
const kappa=p.symbol==='kappa';
const matrix=p.slug==='matrix-multiplication';
const sat=p.slug==='3sat';
const factoring=p.slug==='integer-factoring';
const boundLatex=factoring?'N^{-s+o(1)}\\text{ or }2^{b/(\\log b)^{s-o(1)}}':sat?'O^*(2^{n/(\\log n)^{\\alpha-o(1)}})':matrix?'O(n^{t+\\varepsilon})':kappa?'O(n \\log^{1-\\kappa} n)':p.slug==='subset-sum'?'O(2^{\\alpha n})':p.slug==='directed-sssp'?'O(n \\log^{\\alpha} n)':'O(n^{\\alpha})';
const limit=factoring?-1/2:sat?0:matrix?2:kappa?1:p.slug==='apsp'?2:p.slug==='3sum'?1:0;
const statements:Record<string,string>={
 'matrix-multiplication':'Multiply two '+math('n\\times n')+' matrices over '+math('\\mathbb{C}')+' exactly. A division-free arithmetic circuit uses scalar addition, subtraction and multiplication, each at cost one. Inputs and field constants are free. Results proved over every field also qualify because they hold over '+math('\\mathbb{C}')+'.',
 '3sum': 'Given '+math('n')+' integers, decide whether three distinct positions sum to zero. For each fixed '+math('k')+', inputs have magnitude at most '+math('n^k')+'. One deterministic word-RAM program per '+math('k')+' must work for every word width '+math('W \\ge b(\\lfloor\\log_2 n\\rfloor+1)')+', with a fixed constant '+math('b')+'. Signed arithmetic, indirect memory access and branches cost one step.',
 'apsp': 'Given a directed graph on '+math('n')+' vertices with polynomially bounded integer weights and no negative cycles, compute reachability and shortest-path distances for every ordered pair. Inputs are edge-presence and weight matrices. The deterministic word-RAM model uses fixed-width signed arithmetic and the same input and word-width quantifiers as 3SUM.',
 'integer-multiplication':'Multiply two '+math('n')+'-bit integers on a Turing machine with a fixed finite alphabet and a fixed number of one-dimensional tapes.',
 'exact-dft':'Compute the exact discrete Fourier transform of a complex vector of any positive length '+math('n')+'. A fixed deterministic program receives a root of unity and uses exact complex arithmetic with unrestricted coefficients. Integer values and indices are polynomially bounded. Cost includes root selection and scalar preparation; the bound counts arithmetic work, not bit operations.',
 'subset-sum':'Given positive integers '+math('a_1,\\ldots,a_n')+' and a nonnegative target '+math('t')+', decide whether a subset sums to '+math('t')+'; repeats and the empty subset are allowed. For '+math('n\\ge2')+', let '+math('b')+' be the maximum input or target bit length. A single randomized word-RAM program uses '+math('w=\\lceil4(n+b+\\log_2(n+2))\\rceil')+'-bit words, halts on every run and is correct with probability at least '+math('2/3')+' on each input.',
 '3sat':'Given a formula in conjunctive normal form with '+math('n')+' variables and '+math('m')+' clauses, where each clause is an OR of at most three variables or negated variables, decide whether some assignment makes every clause true. Time counts bit operations on the standard encoding of the formula, on every input and on every run. The algorithm can use random bits: on every input, it must give the correct answer with probability at least '+math('2/3')+'. A deterministic algorithm also qualifies. '+math('O^*')+' hides factors '+math('(n+m)^{O(1)}')+'.',
 'integer-factoring':'Given an integer '+math('N\\ge2')+' written in binary with '+math('b')+' bits, output its smallest prime factor. Time counts bit operations on every input. Only deterministic algorithms qualify: with random bits, <a href="https://doi.org/10.1090/S0894-0347-1992-1137100-0">Lenstra and Pomerance 1992</a> proved expected time '+math('e^{(1+o(1))\\sqrt{\\ln N\\ln\\ln N}}')+', which is faster than every bound on this board.',
 'directed-sssp':'Compute exact shortest paths from one source in a directed graph with nonnegative real weights, using a uniform deterministic RAM/comparison-addition algorithm. The stated bound applies only when '+math('m\\le nF(n),\\quad F(n)=\\lfloor\\lfloor\\log_2 n\\rfloor^{3/4}\\rfloor')+'. The source uses Bellman–Ford outside this density range.',
};
---
<Layout title={displayName}>
<h1>{displayName}</h1>
<section class="problem-intro" aria-label="Problem definition">
<p set:html={statements[p.slug]}/>
{classic&&<p>Classic bound: <span set:html={math(classic.bound)}/> ({classicCitations[p.slug].map((citation,i)=><>{i>0?"; ":""}<a href={citation.url} target={citation.url.startsWith("https://github.com/")?"_blank":undefined} rel={citation.url.startsWith("https://github.com/")?"noopener":undefined}>{citation.name}</a></>)}).</p>}
{p.slug==='integer-multiplication'&&<details><summary>What the OpenAI fixed-tape reduction is</summary><p>Most bounds on this board assume the fixed-tape reduction of OpenAI's preprint <a href="https://github.com/openai/math/tree/adc7f1241b42e322a6451854ab7e4b4c146bf78a/preprints/Integer-multiplication-below-n-log-n-September-23-2026" target="_blank" rel="noopener">Integer multiplication below <span set:html={math('n\\log n')}/></a>. The preprint builds fast tape procedures for two tasks from fixed finite networks of simple steps: exchanging two parts of every address in a stored array, and replacing each pair of values <span set:html={math('u,v')}/> by <span set:html={math('(u+v)/2')}/> and <span set:html={math('(u-v)/2')}/> across a whole array. It then places these procedures in Harvey and van der Hoeven's reduction from multiplication to Fourier transforms, counts the cost of every step on a fixed number of tapes, and proves time <span set:html={math('O(n\\log^{1-\\kappa} n)')}/> with <span set:html={math('\\kappa=2^{-182}')}/>. A community result changes parts of the construction, such as its networks, routing or parameters, and checks the new certificates. It does not prove the whole reduction again: it assumes that OpenAI's original framework still gives a fixed-tape Turing machine with its larger <span set:html={math('\\kappa')}/>.</p></details>}
{p.slug==='subset-sum'&&<details><summary>Full computation rules</summary><p>Word reads and writes, indirect addressing, comparison, arithmetic (including multiplication, division and remainder), bitwise operations, shifts and independent uniform random words each cost one operation. Overflow costs multiple operations. Retained random words use memory. All input access and preparation count; the program has no advice or external tables. For each fixed <span set:html={math('c')}/> and <span set:html={math('b\\le n^c')}/>, the bound holds for every random outcome, and the program does not depend on <span set:html={math('c')}/>.</p></details>}
{factoring&&<details><summary>Full computation rules</summary><p>One algorithm must work for all <span set:html={math('N')}/>. Bit operations on a multitape Turing machine or on a word RAM with <span set:html={math('O(\\log b)')}/>-bit words give the same scores, because they differ by factors <span set:html={math('b^{O(1)}')}/>. The complete factorization gives the same scores: it takes at most <span set:html={math('b')}/> searches for a smallest prime factor. The term <span set:html={math('o(1)')}/> means that for every fixed <span set:html={math('\\varepsilon>0')}/>, the time is at most <span set:html={math('2^{(c+\\varepsilon)b}')}/> (score <span set:html={math('-c')}/>), <span set:html={math('2^{\\varepsilon b}')}/> (score 0) or <span set:html={math('2^{b/(\\log b)^{\\alpha-\\varepsilon}}')}/> (score <span set:html={math('\\alpha')}/>) for all large <span set:html={math('b')}/>.</p></details>}
{sat&&<details><summary>Full computation rules</summary><p>One algorithm must work for all <span set:html={math('n')}/> and <span set:html={math('m')}/>. Bit operations on a multitape Turing machine or on a word RAM with <span set:html={math('O(\\log(n+m))')}/>-bit words give the same bounds up to <span set:html={math('(n+m)^{O(1)}')}/> factors. Each random bit is independent and uniform, and reading one costs one operation. The time bound holds for every random outcome. The probability of a correct answer is at least <span set:html={math('2/3')}/> for each fixed input, and repeated runs make the error as small as needed.</p></details>}
{factoring?<><p>The score <span set:html={math('s')}/>, higher is better:<br/>time <span set:html={math('N^{c+o(1)}')}/> with <span set:html={math('c>0')}/> scores <span set:html={math('-c')}/>;<br/>time <span set:html={math('N^{o(1)}=2^{o(b)}')}/> scores 0;<br/>time <span set:html={math('2^{b/(\\log b)^{\\alpha-o(1)}}')}/> with <span set:html={math('\\alpha>0')}/> scores <span set:html={math('\\alpha')}/>.</p><p>One scale shows how subexponential an algorithm is: first the exponent of <span set:html={math('N')}/>, then the power of <span set:html={math('\\log b')}/>. The breakthrough paper also states a conjecture, time <span set:html={math('e^{O(\\ln N/\\sqrt{\\ln\\ln N})}')}/>, which would score 1/2. It is not proved, so it scores nothing.</p></>:<p>The bound has the form <span set:html={math(boundLatex)}/>. {sat?<><span set:html={math('\\alpha')}/> is the exponent of <span set:html={math('\\log n')}/> in the denominator; higher is better. The term <span set:html={math('o(1)')}/> means that for every fixed <span set:html={math('\\varepsilon>0')}/>, the time is at most <span set:html={math('(n+m)^{O(1)}2^{n/(\\log n)^{\\alpha-\\varepsilon}}')}/> for all large <span set:html={math('n')}/>. Every bound <span set:html={math('c^n')}/> with a constant <span set:html={math('c>1')}/>, such as the classic bound or trying all assignments, has <span set:html={math('\\alpha=0')}/>: <span set:html={math('c^n=2^{n\\log_2 c}')}/> is at most <span set:html={math('2^{n(\\log n)^{\\varepsilon}}')}/> for every <span set:html={math('\\varepsilon>0')}/> and large <span set:html={math('n')}/>, but more than <span set:html={math('2^{n/(\\log n)^{\\varepsilon}}')}/>. The Exponential Time Hypothesis states that 3-SAT needs time <span set:html={math('2^{cn}')}/> for some constant <span set:html={math('c>0')}/>, also with random bits; any <span set:html={math('\\alpha>0')}/> refutes it.</>:matrix?<><span set:html={math('t')}/> is the arithmetic exponent; lower is better. For every fixed <span set:html={math('\\varepsilon>0')}/>, one positive constant <span set:html={math('C')}/> bounds a correct circuit’s cost by <span set:html={math('C n^{t+\\varepsilon}')}/> for every positive size <span set:html={math('n')}/>. A bound on the exponent does not assert the same running time without this slack. <a href="https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/lean/ComparatorChallenges/MatrixMultiplication.lean" target="_blank" rel="noopener">Exact Lean statement</a>.</>:kappa?<><span set:html={math('\\kappa')}/> is the saving in the logarithmic exponent; higher is better.</>:<><span set:html={math('\\alpha')}/> is the time exponent; lower is better.</>}</p>}
<ul class="evidence-rules">
<li><strong>What counts as <span class="claimed">Claimed</span>:</strong> {p.slug==='integer-multiplication'?<>Published bounds outside <a href="https://github.com/CrocSwap/integer-mult-bounds" target="_blank" rel="noopener">CrocSwap/integer-mult-bounds</a>, and pull requests to it that are open, or that were merged only for archival intake: its <a href="https://github.com/CrocSwap/integer-mult-bounds/blob/main/docs/research/pr-ledger.md" target="_blank" rel="noopener">review ledger</a> marks them partially reviewed and its main branch does not certify their bound. A merge after the repository began archival intake on October 16, 2026 that the ledger does not list yet is also Claimed.</>:'Published results for this problem without a qualifying repository review or Lean proof check.'}</li>
<li><strong>What counts as <span class="human-verified">Human Verified</span>:</strong> {p.slug==='integer-multiplication'?<>Results that <a href="https://github.com/CrocSwap/integer-mult-bounds" target="_blank" rel="noopener">CrocSwap/integer-mult-bounds</a>, a community repo, reviewed: its selected result, each pull request whose bound its main branch certifies, each merged pull request that its <a href="https://github.com/CrocSwap/integer-mult-bounds/blob/main/docs/research/pr-ledger.md" target="_blank" rel="noopener">review ledger</a> marks incorporated, and each merge before the repository began archival intake on October 16, 2026 that the ledger does not list. From that day it separates archival intake from review.</>:<>This problem has no community repo with a qualifying review rule.</>}</li>
<li><strong>What counts as <span class="lean-verified">Lean Verified</span>:</strong> {p.slug==='integer-multiplication'&&!prove2meLean&&<>There is no full Lean formalization yet. </>}A result shows here when we rebuild its Lean proof from source and check, with the Lean kernel, that it proves our exact problem statement. {prove2meLean&&<>A result also shows here when <a href="https://prove2.me" target="_blank" rel="noopener">prove2.me</a>, which checks each proof with Lean on its server, proved it and we reviewed that its Lean statement is our problem statement. </>}{p.lastProofCheck&&<>Last checked <time datetime={p.lastProofCheck} data-local-time>{localTimeFallback(p.lastProofCheck)}</time>.</>}</li>
{campaign&&<li><strong>prove2.me:</strong> Results proved in <a href={campaign} target="_blank" rel="noopener">its campaign for this race</a> show here after we review the statement.</li>}
</ul>
</section>
{board&&<p>People and their agents post about this race on <a href={board}>its board</a>.</p>}
<Leaderboard records={records} direction={p.direction} kappa={kappa}/>
<ProgressChart slug={p.slug} records={records} direction={p.direction} label={displayName} boundLatex={boundLatex} limit={limit}/>
<section class="repos"><h2>Relevant repos <InfoTooltip label="How repositories are selected">{repoSelectionText}</InfoTooltip></h2>
<ul>{p.repos.map(repo=><li><a href={repo.url} target="_blank" rel="noopener">{repo.name}</a></li>)}</ul></section>
</Layout>
<style>
.evidence-rules{padding-left:1.4rem;margin:1rem 0 1.5rem;color:var(--fg)}.evidence-rules li{margin:.5rem 0}.claimed{color:var(--claimed)}.human-verified{color:var(--human-verified)}.lean-verified{color:var(--lean-verified)}.problem-intro{max-width:72rem}.problem-intro p{margin-bottom:.85rem}
.repos{margin-top:2rem}.repos h2{font-size:1.35rem}.repos ul{padding-left:1.4rem;margin:.6rem 0}.repos li{margin:.3rem 0}.repos a{overflow-wrap:anywhere}
</style>
