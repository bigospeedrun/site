---
import data from '../lib/other-bounds-data';
import LandingTable from './LandingTable.astro';
import {otherBoundLeader} from '../lib/other-leader';
const rows=data.families.map(f=>{
  const best=otherBoundLeader(f)!;
  return {href:'/other/'+f.slug,name:f.name,breakthrough:f.baseline.bound,source:f.baseline.url,
    latest:[{bound:best.bound,url:best.url,evidenceLevel:best.evidence as 'claimed'|'lean-verified',date:best.date}]};
});
---
<section aria-labelledby="other-bounds">
  <h2 id="other-bounds">Other bounds</h2>
  <LandingTable rows={rows} label="Other bounds from the October 6 release" />
</section>
