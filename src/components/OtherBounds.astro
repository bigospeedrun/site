---
import data from '../lib/other-bounds-data';
import LandingTable from './LandingTable.astro';
import {otherBoundLeader} from '../lib/other-leader';
import {otherReviewPrUrl, type EvidenceLevel, type OtherClaimReview, type OtherReviewRepository} from '../lib/evidence';
const rows=data.families.map(f=>{
  const best=otherBoundLeader(f)!;
  const repo=(f as {reviewRepository?:OtherReviewRepository}).reviewRepository,review=(best as {review?:OtherClaimReview}).review;
  return {href:'/other/'+f.slug,name:f.name,breakthrough:f.baseline.bound,source:f.baseline.url,
    // A Lean Verified leader's label opens its evidence: the prove2.me theorem page for an import. A Human
    // Verified leader's label opens the pull request that the row's review repository merged.
    latest:[{bound:best.bound,url:best.url,evidenceLevel:best.evidence as EvidenceLevel,date:best.date,
      evidenceUrl:best.evidence==='lean-verified'?best.url:best.evidence==='human-verified'&&repo&&review?otherReviewPrUrl(repo,review):undefined}]};
});
---
<section aria-labelledby="other-bounds">
  <h2 id="other-bounds">Other bounds</h2>
  <LandingTable rows={rows} label="Other bounds" initialBoundLabel="Baseline" initialBoundDefinition="The cited starting bound for each problem. Its source states the applicable conditions and computation model." />
</section>
