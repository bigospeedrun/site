---
import data from '../lib/other-bounds-data';
import LandingTable from './LandingTable.astro';
import {otherBoundLeader} from '../lib/other-leader';
import {baselineClaim, isOpenAIBaseline} from '../lib/other-table';
import {routeEvidenceUrl, isClosedRace, closedRaceRule} from '../lib/other-route';
import {otherReviewPrUrl, type EvidenceLevel, type OtherClaimReview, type OtherReviewRepository} from '../lib/evidence';
// A race with a closedStatus has a result that cannot be improved; it leaves the open list for its own group (Nil, 2026-11-20).
const toRow=(f:(typeof data.families)[number])=>{
  const best=otherBoundLeader(f)!;
  const repo=(f as {reviewRepository?:OtherReviewRepository}).reviewRepository,review=(best as {review?:OtherClaimReview}).review;
  // The OpenAI baseline of a row is its agent breakthrough. A row with a classic baseline (a labeled
  // baseline from a paper) is not an agent result: its agent breakthrough is its first claim marked
  // agent, and a row with no such claim has none. A row with no baseline is the same.
  const classic=!isOpenAIBaseline(f.baseline);
  const noBreakthrough='noBreakthrough' in f&&f.noBreakthrough===true;
  const first=classic&&!noBreakthrough?[...f.claims].filter(c=>'agent' in c&&c.agent).sort((a,b)=>Date.parse(a.date)-Date.parse(b.date))[0]:undefined;
  return {href:'/other/'+f.slug,name:f.name,noBreakthrough,nameMath:'nameMath' in f?f.nameMath:undefined,
    breakthrough:classic?first?.bound:f.baseline?.bound,source:classic?first?.url:f.baseline?.url,
    breakthroughAuthors:classic?first?.authors:baselineClaim(f.baseline)?.authors,
    // A Lean Verified leader's label opens its evidence: the prove2.me theorem page for an import. A Human
    // Verified leader's label opens the pull request that the row's review repository merged.
    latest:[{bound:best.bound,url:best.url,evidenceLevel:best.evidence as EvidenceLevel,date:best.date,
      evidenceUrl:best.evidence==='lean-verified'?(best as {evidenceUrl?:string}).evidenceUrl??routeEvidenceUrl(f,best)??best.url:best.evidence==='human-verified'&&repo&&review?otherReviewPrUrl(repo,review):undefined,authors:best.authors,refiledBy:(best as {refiledBy?:string}).refiledBy}]};
};
const rows=data.families.filter(f=>!isClosedRace(f)).map(toRow);
const closedRows=data.families.filter(isClosedRace).map(toRow);
---
<section aria-labelledby="other-bounds">
  <h2 id="other-bounds">Other bounds</h2>
  <LandingTable rows={rows} label="Other bounds" />
</section>
{closedRows.length>0&&<section aria-labelledby="closed-races">
  <h2 id="closed-races">Closed races</h2>
  <p>{closedRaceRule}</p>
  <LandingTable rows={closedRows} label="Closed races" />
</section>}
