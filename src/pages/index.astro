---
import Layout from '../layouts/Layout.astro';
import OtherBounds from '../components/OtherBounds.astro';
import ContributePrompt from '../components/ContributePrompt.astro';
import {problemDisplayName} from '../lib/navigation';
import LandingTable from '../components/LandingTable.astro';
import content from '../lib/landing.html?raw';
import {inlineMath} from '../lib/math';
import {problems, boardRecords} from '../lib/data';
import {landingRecords} from '../lib/landing-records';
import EvidenceFilters from '../components/EvidenceFilters.astro';
import {breakthroughLabel} from '../lib/evidence';
const rows = [
  {slug:'integer-multiplication', classic:'O(n \\log n)', breakthroughId:'openai-original-109', source:'https://github.com/openai/math/tree/main/preprints/Integer-multiplication-below-n-log-n-September-23-2026'},
  {slug:'matrix-multiplication', classic:'O(n^{2.371177+\\varepsilon})', breakthroughId:'openai-matrix-nine-fourths-2026', source:'https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Matrix-Multiplication-Nine-Fourths-October-2-2026/paper.pdf'},
  {slug:'exact-dft', classic:'O(n \\log n)', breakthroughId:'exact-dft-2026', source:'https://github.com/openai/math/tree/main/preprints/An-explicit-power-saving-for-the-exact-discrete-Fourier-transform-September-25-2026'},
  {slug:'3sum', classic:'O(n^2)', breakthroughId:'anthropic-2026', source:'https://arxiv.org/abs/2610.06783'},
  {slug:'apsp', classic:'O(n^3)', breakthroughId:'anthropic-2026', source:'https://arxiv.org/abs/2610.06783'},
  {slug:'subset-sum', classic:'O^*(2^{n/2})', breakthroughId:'subset-sum-2026', source:'https://github.com/openai/math/tree/main/preprints/Subset-Sum-in-Time-2-power-0-49n-October-4-2026'},
].map(row=>{
  const problem=problems.find(p=>p.slug===row.slug)!;
  const records=boardRecords(problem);
  const breakthroughRecord=problem.records.find(record=>record.id===row.breakthroughId)!;
  const breakthrough=breakthroughRecord.shortBound??breakthroughRecord.bound;
  const latest=landingRecords(records,problem.direction).map(record=>({bound:record.shortBound??record.bound,url:record.evidence[0]?.url??'/'+row.slug,evidenceLevel:record.evidenceLevel,date:record.date,endpoint:record.scoreRelation==='strict-upper-bound'}));
  return {...row,href:'/'+row.slug,name:problemDisplayName(row.slug),breakthrough,latest,endpoint:latest.some(record=>record.endpoint)};
});

---
<Layout title="Big O Speedrun" home>
  <div class="landing">
    <div set:html={inlineMath(content)}/>
    <h2>Big O</h2>
    <EvidenceFilters />
    <LandingTable rows={rows} id="problems" label={`Compare classic bounds, ${breakthroughLabel.toLowerCase()}s, and latest results`} classic />
    <OtherBounds />
    <p>This website tracks progress on these problems and helps people and agents get started. Inspired by the <a href="https://github.com/KellerJordan/modded-nanogpt" target="_blank" rel="noopener">NanoGPT speedrun</a> and hoping to bring similar progress and interest to our classic problems. Join the <a href="https://discord.gg/JEN582WvNv" target="_blank" rel="noopener">Discord</a> to better coordinate your agent swarms with others.</p>
    <ContributePrompt />
  </div>
</Layout>
