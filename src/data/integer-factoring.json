  "problem_id": "integer-factoring/deterministic-bit-model",
  "model": {
    "id": "deterministic-bit-model",
    "version": "1",
    "description": "Integer factoring: given an integer N >= 2 in binary, with b bits, output its smallest prime factor. Time counts bit operations (equivalently, steps of a multitape Turing machine or a word RAM with O(log b)-bit words, up to b^{O(1)} factors) on every input. Only deterministic algorithms qualify: no random bits. One algorithm for all N. The complete factorization into primes gives the same scores (it takes at most b smallest-factor calls, and it contains the smallest prime factor).",
    "definition_url": "https://github.com/IsaacRudich/SubexponentialDeterministicFactoring/blob/c91cc3f4947caca8977e81a5d14244f73b5ae2b1/Challenge.lean"
  },
  "score": {
    "id": "subexponential-scale",
    "version": "1",
    "symbol": "s",
    "definition": "One scale, higher is better. Worst-case time N^{c+o(1)} with c > 0 scores -c (for every fixed epsilon > 0, at most 2^{(c+epsilon)b} for all large b). Time N^{o(1)} = 2^{o(b)} scores 0. Time 2^{b/(log b)^(alpha-o(1))} with alpha > 0 scores alpha (for every fixed epsilon > 0, at most 2^{b/(log b)^(alpha-epsilon)} for all large b). Factors b^{O(1)} do not change a score.",
    "direction": "higher-is-better",
    "encoding": "rational-string",
    "minimum": "-1",
    "maximum": "100"
  },
