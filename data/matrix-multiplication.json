    "id": "arithmetic-exponent",
    "version": "1",
    "symbol": "t",
    "definition": "An exponent t guarantees O(n^(t+epsilon)) scalar operations for every fixed epsilon > 0.",
    "direction": "lower-is-better",
    "encoding": "rational-string",
    "minimum": "2",
    "maximum": "3"
  },
