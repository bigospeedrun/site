  "problem_id": "directed-sssp/comparison-addition-sparse",
  "model": {
    "id": "comparison-addition-sparse",
    "version": "2",
    "description": "Exact directed single-source shortest paths with nonnegative real weights in the comparison-addition word RAM of the C-HD proof (bigospeedrun/c-hd-proof, fork of spicylemonade/c-hd-proof, pinned commit 98c53accb47a505482a1781597ae14bf67e81cec). A row says: with at most D(n) edges, the time is O(T(n)), with D(n) = n^a floor(floor(log2 n)^b) and T(n) = n^a' (log n)^b' (log log n)^c'. A function row gives the time of a published algorithm as a function of m at every density.",
    "definition_url": "https://github.com/bigospeedrun/verifier/blob/main/challenges/directed-sssp/README.md"
  },
  "score": {
    "id": "density-time",
    "version": "1",
    "symbol": "D ; T",
    "definition": "A point row \"D ; T\": with at most D(n) edges, the time is O(T(n)). A function row: the time as a sum of terms in m and n. Times compare by the lexicographic order of the exponents of n, log n and log log n (data/sssp.py).",
    "direction": "lower-is-better",
    "encoding": "density-time",
    "minimum": "n ; n",
    "maximum": "n^2 ; n^3"
  },
